# Copie para .env (o .env NÃO vai para o git) e ajuste.

# Porta e endereço do servidor
PORT=3000
HOST=0.0.0.0

# Pasta dos dados (banco SQLite, catálogo inicial). Fora do git.
DATA_DIR=./data

# Use "true" quando o servidor estiver atrás de HTTPS (cookie Secure).
COOKIE_SECURE=false

# Se o servidor estiver atrás de um proxy reverso (nginx, IIS, Cloudflare), informe o nº de saltos.
TRUST_PROXY=0

# Duração da sessão: inatividade máxima (horas) e duração absoluta (dias).
SESSAO_INATIVIDADE_HORAS=12
SESSAO_MAXIMA_DIAS=7

# Arquivos de configuração (fora do git; veja config/*.example.json)
ORGANIZACAO_ARQUIVO=./config/organizacao.json
USUARIOS_INICIAIS_ARQUIVO=./config/usuarios-iniciais.json
CATALOGO_INICIAL_ARQUIVO=./data/catalogo-inicial.json
