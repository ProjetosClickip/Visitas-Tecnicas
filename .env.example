# Copie para .env.local (fica fora do git) e preencha.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# Supabase → Project Settings → API (ou Connect)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave PUBLICÁVEL (sb_publishable_...). Ela foi feita para ficar no site:
# quem protege os dados são as regras do banco. NUNCA use a chave secreta / service_role aqui.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
