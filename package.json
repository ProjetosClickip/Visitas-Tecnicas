{
  "name": "clickip-plataforma",
  "version": "2.0.0",
  "private": true,
  "description": "Plataforma de Projetos Click IP – Visitas Técnicas e Mensuração de Custos (Supabase)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preparar:ocr": "node scripts/copiar-ocr.js",
    "predev": "node scripts/copiar-ocr.js",
    "dev": "vite --config web/vite.config.js",
    "prebuild": "node scripts/copiar-ocr.js",
    "build": "vite build --config web/vite.config.js",
    "preview": "vite preview --config web/vite.config.js",
    "test": "node --test test/*.test.js",
    "sql:privado": "node scripts/gerar-sql-privado.js",
    "test:e2e": "node test/e2e/fumaca.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "chart.js": "^4.6.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^7.0.0",
    "vite": "^8.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
